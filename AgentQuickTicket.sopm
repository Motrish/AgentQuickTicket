<?xml version="1.0" encoding="utf-8" ?>
<otobo_package version="1.1">
    <Name>AgentQuickTicket</Name>
    <Version>1.0.19</Version>
    <Vendor>Michael Nehmer | Motrish</Vendor>
    <URL>https://github.com/Motrish/AgentQuickTicket</URL>
    <License>GNU GENERAL PUBLIC LICENSE Version 3, 29 June 2007</License>
    <Framework>11.0.x</Framework>
    <Framework>11.2.x</Framework>
    <PackageIsVisible>1</PackageIsVisible>
    <PackageIsDownloadable>1</PackageIsDownloadable>
    <PackageIsRemovable>1</PackageIsRemovable>
    <PackageAllowDirectUpdate>1</PackageAllowDirectUpdate>
    <Description Lang="en">Configurable agent quick ticket profiles for AgentTicketPhone.</Description>
    <Description Lang="de">Konfigurierbare Schnellticket-Profile für AgentTicketPhone.</Description>
    <ChangeLog Date="2026-09-23" Version="1.0.19">Place packaged documentation in doc/AgentQuickTicket to avoid collisions with other OTOBO packages.</ChangeLog>
    <ChangeLog Date="2026-09-23" Version="1.0.18">Run OTOBO's ServiceID AJAXUpdate after a quick ticket profile postback so service-dependent dynamic field ACLs remain active.</ChangeLog>
    <ChangeLog Date="2026-09-23" Version="1.0.17">Keep the AgentTicketPhone action in the native profile refresh request so action-scoped ACLs continue to apply when dynamic fields change.</ChangeLog>
    <ChangeLog Date="2026-09-22" Version="1.0.16">Add configurable separator lines before selected profiles in the administration overview and AgentTicketPhone widget.</ChangeLog>
    <ChangeLog Date="2026-09-21" Version="1.0.15">Read all profiles before loading group mappings so the admin list shows every profile.</ChangeLog>
    <ChangeLog Date="2026-09-21" Version="1.0.14">Clean orphaned profile-group mappings and roll back incomplete profile creation.</ChangeLog>
    <ChangeLog Date="2026-09-21" Version="1.0.13">Create the profile-group table during package upgrades when the previous database installation was incomplete.</ChangeLog>
    <ChangeLog Date="2026-09-21" Version="1.0.12">Use OTOBO-compatible database identifier lengths for all profile tables, constraints and indexes.</ChangeLog>
    <ChangeLog Date="2026-09-21" Version="1.0.11">Use OTOBO-compatible database identifier lengths for the profile group table and its indexes.</ChangeLog>
    <ChangeLog Date="2026-09-21" Version="1.0.10">Include the OTOBO challenge token in the administration save form and log failed profile saves.</ChangeLog>
    <ChangeLog Date="2026-09-18" Version="1.0.9">Redraw visible OTOBO Modernize fields after applying a profile so selections such as next ticket state are immediately visible.</ChangeLog>
    <ChangeLog Date="2026-09-18" Version="1.0.8">Rewrite the user documentation with installation, configuration, placeholders, troubleshooting, security and operational guidance.</ChangeLog>
    <ChangeLog Date="2026-09-18" Version="1.0.7">Merge the German AgentQuickTicket translations into the existing OTOBO catalog instead of replacing all core translations.</ChangeLog>
    <ChangeLog Date="2026-09-18" Version="1.0.6">Keep the German language extension plugin-specific and translate AgentQuickTicket validation and AJAX messages without overriding OTOBO core translations.</ChangeLog>
    <ChangeLog Date="2026-09-18" Version="1.0.5">Keep article-text profiles on the current AgentTicketPhone form so CKEditor does not restore the screen default during the prefill refresh.</ChangeLog>
    <ChangeLog Date="2026-09-18" Version="1.0.4">Preserve profile values during AgentTicketPhone prefill refresh, synchronize the article text with CKEditor and improve ResolveProfile error reporting.</ChangeLog>
    <ChangeLog Date="2026-09-18" Version="1.0.3">Initialize admin controls and the AgentTicketPhone widget in OTOBO's APP_MODULE lifecycle so the dynamic-field editor and widget are active after configuration loading.</ChangeLog>
    <ChangeLog Date="2026-09-18" Version="1.0.2">Rebuild the distributable with the exact OTOBO PackageBuild element and attribute order.</ChangeLog>
    <ChangeLog Date="2026-09-18" Version="1.0.1">Fix package metadata and lifecycle declarations for reliable installation through the OTOBO package manager.</ChangeLog>
    <ChangeLog Version="1.0.0">Initial release: admin CRUD, AgentTicketPhone widget, server-side validation, placeholders and demo profile.</ChangeLog>

    <Filelist>
        <File Permission="644" Location="Kernel/Config/Files/XML/AgentQuickTicket.xml" />
        <File Permission="644" Location="Kernel/Language/de_AgentQuickTicket.pm" />
        <File Permission="644" Location="Kernel/Language/en_AgentQuickTicket.pm" />
        <File Permission="644" Location="Kernel/Modules/AdminAgentQuickTicket.pm" />
        <File Permission="644" Location="Kernel/Modules/AgentQuickTicket.pm" />
        <File Permission="644" Location="Kernel/Output/HTML/FilterElementPost/AgentQuickTicket.pm" />
        <File Permission="644" Location="Kernel/Output/HTML/Templates/Standard/AdminAgentQuickTicket.tt" />
        <File Permission="644" Location="Kernel/Output/HTML/Templates/Standard/AdminAgentQuickTicketEdit.tt" />
        <File Permission="644" Location="Kernel/Output/HTML/Templates/Standard/AgentQuickTicketWidget.tt" />
        <File Permission="644" Location="Kernel/System/AgentQuickTicket.pm" />
        <File Permission="644" Location="var/httpd/htdocs/js/Core.Agent.Admin.AgentQuickTicket.js" />
        <File Permission="644" Location="var/httpd/htdocs/js/Core.Agent.AgentQuickTicket.js" />
        <File Permission="644" Location="var/httpd/htdocs/skins/Agent/default/css/AgentQuickTicket.css" />
        <File Permission="755" Location="scripts/AgentQuickTicketMigrate.pl" />
        <File Permission="644" Location="doc/AgentQuickTicket/ADMIN.md" />
        <File Permission="644" Location="doc/AgentQuickTicket/CHANGELOG.md" />
        <File Permission="644" Location="doc/AgentQuickTicket/INSTALL.md" />
        <File Permission="644" Location="doc/AgentQuickTicket/README.md" />
    </Filelist>

    <DatabaseInstall Type="post">
        <TableCreate Name="agent_quick_ticket_profile">
            <Column Name="id" Required="true" PrimaryKey="true" AutoIncrement="true" Type="INTEGER" />
            <Column Name="internal_name" Required="true" Size="191" Type="VARCHAR" />
            <Column Name="label" Required="true" Size="191" Type="VARCHAR" />
            <Column Name="description" Required="false" Size="2000" Type="VARCHAR" />
            <Column Name="icon" Required="true" Size="100" Type="VARCHAR" />
            <Column Name="color" Required="true" Size="50" Type="VARCHAR" />
            <Column Name="sort_order" Required="true" Type="INTEGER" />
            <Column Name="configuration" Required="true" Type="LONGBLOB" />
            <Column Name="valid_id" Required="true" Type="SMALLINT" />
            <Column Name="create_time" Required="true" Type="DATE" />
            <Column Name="create_by" Required="true" Type="INTEGER" />
            <Column Name="change_time" Required="true" Type="DATE" />
            <Column Name="change_by" Required="true" Type="INTEGER" />
            <Unique Name="aqt_profile_iname_uniq">
                <UniqueColumn Name="internal_name" />
            </Unique>
            <ForeignKey ForeignTable="valid">
                <Reference Local="valid_id" Foreign="id" />
            </ForeignKey>
            <ForeignKey ForeignTable="users">
                <Reference Local="create_by" Foreign="id" />
                <Reference Local="change_by" Foreign="id" />
            </ForeignKey>
        </TableCreate>
        <TableCreate Name="agent_quick_ticket_profile_grp">
            <Column Name="profile_id" Required="true" Type="INTEGER" />
            <Column Name="group_id" Required="true" Type="INTEGER" />
            <Unique Name="aqt_profile_grp_uniq">
                <UniqueColumn Name="profile_id" />
                <UniqueColumn Name="group_id" />
            </Unique>
            <Index Name="aqt_profile_grp_pid">
                <IndexColumn Name="profile_id" />
            </Index>
            <Index Name="aqt_profile_grp_gid">
                <IndexColumn Name="group_id" />
            </Index>
            <ForeignKey ForeignTable="agent_quick_ticket_profile">
                <Reference Local="profile_id" Foreign="id" />
            </ForeignKey>
            <ForeignKey ForeignTable="groups_table">
                <Reference Local="group_id" Foreign="id" />
            </ForeignKey>
        </TableCreate>
    </DatabaseInstall>

    <DatabaseUninstall Type="pre">
        <TableDrop Name="agent_quick_ticket_profile_grp" />
        <TableDrop Name="agent_quick_ticket_profile" />
    </DatabaseUninstall>

    <CodeInstall Type="post"><![CDATA[
my $AgentQuickTicketObject = $Kernel::OM->Get('Kernel::System::AgentQuickTicket');
$AgentQuickTicketObject->EnsureDatabaseSchema();
$AgentQuickTicketObject->SeedDemoProfile( UserID => 1 );
    ]]></CodeInstall>
    <CodeUpgrade Type="post"><![CDATA[
my $AgentQuickTicketObject = $Kernel::OM->Get('Kernel::System::AgentQuickTicket');
$AgentQuickTicketObject->EnsureDatabaseSchema();
$AgentQuickTicketObject->SeedDemoProfile( UserID => 1 );
    ]]></CodeUpgrade>
    <CodeReinstall Type="post"><![CDATA[
my $AgentQuickTicketObject = $Kernel::OM->Get('Kernel::System::AgentQuickTicket');
$AgentQuickTicketObject->EnsureDatabaseSchema();
$AgentQuickTicketObject->SeedDemoProfile( UserID => 1 );
    ]]></CodeReinstall>
</otobo_package>
